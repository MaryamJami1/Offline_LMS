# The server PC's address on the lab LAN. LiveKit advertises this to the
# student PC as its WebRTC candidate, so it must be the real LAN IP and
# not 127.0.0.1.
LAN_IP=192.168.10.2

# Must match apiKey / apiSecret in config.json.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=spike-only-secret-at-least-32-characters-long
