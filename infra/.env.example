DATABASE_URL=postgresql://lingualab:change-me-to-a-strong-password@localhost:5432/lingualab

# LiveKit
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Caddy (uses LAN_IP above)
