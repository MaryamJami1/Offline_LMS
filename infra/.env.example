# Copy to infra/.env before the first `docker compose up -d`.
# Every variable below is required: compose refuses to start without them
# rather than bringing up a database with a blank password.

# Network — the server machine's own IP on the lab network. LiveKit advertises
# this to the lab PCs as its WebRTC candidate, so 127.0.0.1 will not work.
# Find it with `ipconfig` (Windows) or `ip addr` (Linux).
LAN_IP=192.168.10.2

# PostgreSQL. DATABASE_URL is read by the server and must carry the same user,
# password and database name as the three variables above it.
POSTGRES_USER=lingualab
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=lingualab
DATABASE_URL=postgresql://lingualab:change-me-to-a-strong-password@localhost:5432/lingualab

# LiveKit. The secret must be at least 32 characters. The apps mint their own
# LiveKit tokens from this pair, so it is never copied to a lab PC.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Caddy reads LAN_IP above as its site address and issues its own certificate
# for it, so nothing here needs the internet.
