{
  "name": "@lingualab/student",
  "version": "0.1.0",
  "private": true,
  "description": "The student app on the lab PCs",
  "author": "LinguaLab",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "vite build -c vite.renderer.config.ts && vite build -c vite.main.config.ts && vite build -c vite.preload.config.ts",
    "dev": "node scripts/dev.mjs",
    "test": "vitest run",
    "lint": "eslint src/ scripts/ vite.*.ts",
    "typecheck": "tsc --noEmit",
    "installer": "pnpm build && electron-builder --win --publish never"
  },
  "devDependencies": {
    "@lingualab/shared": "workspace:*",
    "@lingualab/ui": "workspace:*",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "44.9.3",
    "electron-builder": "26.18.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.4",
    "vite": "8.3.5",
    "zod": "^4.6.7"
  }
}
